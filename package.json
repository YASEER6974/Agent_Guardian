{
  "name": "mcp-guardian",
  "displayName": "MCP Guardian",
  "description": "Defend AI agents against MCP Tool Poisoning and Prompt Injection using cryptographic fingerprinting and call-graph anomaly detection.",
  "version": "1.0.0",
  "publisher": "antigravity",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YASEER6974/Agent_Guardian.git"
  },
  "homepage": "https://agent-guardian.vercel.app/",
  "keywords": [
    "mcp",
    "agent-security",
    "prompt-injection",
    "vscode",
    "model-context-protocol"
  ],
  "files": [
    "assets/",
    "dist/",
    "src/webview/sidebar.html",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Security",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:mcp-guardian.dashboard"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "mcp-guardian-proxy": "./dist/proxy.js",
    "agent-guardian": "./dist/cli.js",
    "agent-guardian-browser": "./dist/browser-cli.js",
    "agent-guardian-evaluate": "./dist/evaluate-cli.js"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mcp-guardian.proxy",
        "label": "Agent Guardian"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcp-guardian-explorer",
          "title": "MCP Guardian",
          "icon": "assets/shield.svg"
        }
      ]
    },
    "views": {
      "mcp-guardian-explorer": [
        {
          "type": "webview",
          "id": "mcp-guardian.dashboard",
          "name": "Dashboard",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      { "command": "mcp-guardian.refreshDashboard", "title": "MCP Guardian: Refresh Dashboard" },
      { "command": "mcp-guardian.addExternalServer", "title": "MCP Guardian: Add External MCP Server" },
      { "command": "mcp-guardian.guardWorkspaceServers", "title": "MCP Guardian: Guard Workspace MCP Servers" },
      {
        "command": "mcp-guardian.openDashboard",
        "title": "MCP Guardian: Open Dashboard"
      },
      {
        "command": "mcp-guardian.approveTool",
        "title": "MCP Guardian: Approve Pending Tool"
      },
      {
        "command": "mcp-guardian.denyTool",
        "title": "MCP Guardian: Deny Pending Tool"
      },
      {
        "command": "mcp-guardian.exportAuditJson",
        "title": "MCP Guardian: Export Audit as JSON"
      },
      {
        "command": "mcp-guardian.exportAuditJsonl",
        "title": "MCP Guardian: Export Audit as JSONL"
      },
      {
        "command": "mcp-guardian.exportAuditSarif",
        "title": "MCP Guardian: Export Audit as SARIF"
      }
    ],
    "configuration": {
      "title": "MCP Guardian",
      "properties": {
        "mcp-guardian.servers": {
          "type": "array",
          "markdownDescription": "List of downstream MCP servers to manage and proxy.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "anyOf": [ { "required": ["command"] }, { "required": ["url"] } ],
            "properties": {
              "type": { "type": "string", "enum": ["stdio", "http"], "description": "Downstream MCP transport." },
              "url": { "type": "string", "description": "Remote Streamable HTTP MCP endpoint." },
              "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Optional HTTP headers; use ${env:VARIABLE} for authentication." },
              "name": {
                "type": "string",
                "description": "Unique identifier for the downstream server."
              },
              "command": {
                "type": "string",
                "description": "Command to run the server (e.g. node, npx, python)."
              },
              "cwd": { "type": "string", "description": "Working directory for a local MCP server." },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the command."
              },
              "env": {
                "type": "object",
                "description": "Environment variables."
              }
            }
          },
          "default": [
            {
              "name": "everything",
              "command": "npx",
              "args": [
                "-y",
                "@modelcontextprotocol/server-everything"
              ]
            }
          ]
        },
        "mcp-guardian.storagePath": {
          "type": "string",
          "markdownDescription": "Local Guardian database directory shared by the extension and proxy. Leave empty to use the user home directory.",
          "default": ""
        },
        "mcp-guardian.wsPort": {
          "type": "number",
          "markdownDescription": "Local WebSocket port for communication with the Guardian proxy.",
          "default": 1337
        },
        "mcp-guardian.forbiddenTransitions": {
          "type": "array",
          "markdownDescription": "List of forbidden category transitions [From, To].",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "default": [
            [
              "READ_LOCAL",
              "WRITE_COMMUNICATION"
            ],
            [
              "READ_FINANCIAL",
              "WRITE_COMMUNICATION"
            ],
            [
              "READ_LOCAL",
              "EXECUTE_SYSTEM"
            ],
            [
              "READ_NETWORK",
              "EXECUTE_SYSTEM"
            ]
          ]
        },
        "mcp-guardian.geminiApiKey": {
          "type": "string",
          "markdownDescription": "Gemini API key for semantic prompt-injection scans. If blank, falls back to heuristic scanner.",
          "default": ""
        },
        "mcp-guardian.autoApproveSafe": {
          "type": "boolean",
          "markdownDescription": "Automatically approve tool calls that do not trigger forbidden transitions or show metadata drift.",
          "default": true
        },
        "mcp-guardian.sessionIntent": {
          "type": "string",
          "markdownDescription": "Default out-of-band intent for Guardian sessions.",
          "default": ""
        },
        "mcp-guardian.allowedCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Default capabilities allowed by the session policy. Empty means unspecified.",
          "default": []
        },
        "mcp-guardian.trustedDestinations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Destinations trusted by the default session policy.",
          "default": []
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "demo": "npm run build && node demo/run-demo.js",
    "demo:headed": "npm run build && node demo/run-demo.js --headed",
    "pack:check": "npm run build && npm pack --dry-run",
    "evaluate": "npm run build && node dist/evaluate-cli.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsonc-parser": "3.3.1",
    "ws": "^8.16.0"
  }
}
